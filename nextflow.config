// AFLA demultiplexer for EPI2ME Desktop. Education and research use only, not for clinical use.

params {
    platform = "illumina"
    input = null
    sample_sheet = null
    out_dir = "output"
    threads = 8

    // Illumina
    mismatches = 1
    i5_direction = "auto"

    // Nanopore
    max_error = 0.2
    min_margin = 3
    search_window = 150
    min_length = 50
    max_length = 0
    require_both_ends = false

    help = false
    version = false
    disable_ping = true
}

manifest {
    name = "afla-demux"
    author = "AFLA project"
    description = "Sorts Illumina or Nanopore reads into one set of FASTQ files per sample using a sample sheet. Not for clinical use."
    mainScript = "main.nf"
    nextflowVersion = ">=23.04.0"
    version = "0.1.0"
}

process {
    shell = ["/bin/bash", "-euo", "pipefail"]
    cpus = 2
    memory = "4 GB"
    withLabel: "big" {
        cpus = { params.threads }
        memory = "12 GB"
    }
}

executor {
    cpus = params.threads
}

profiles {
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }
}
